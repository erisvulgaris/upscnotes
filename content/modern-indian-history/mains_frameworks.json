{
  "types": [
    { "id": "impact", "label": "Examine the impact",
      "match": ["impact", "effect", "consequence", "affect", "result of", "led to", "outcome", "repercussion"],
      "demand": "Show how the event changed things across domains, short- and long-term.",
      "frame": { "intro": "Name the event + its immediate context.",
                 "body": ["Political effects", "Economic effects", "Social/cultural effects", "Short-term vs long-term"],
                 "conclusion": "Net significance / which effect was decisive." } },
    { "id": "causes", "label": "Why / causes",
      "match": ["why", "cause", "reason", "what led to", "factors behind", "account for", "factors", "roots of", "rise of"],
      "demand": "Marshal and weigh the reasons.",
      "frame": { "intro": "State the phenomenon + context.",
                 "body": ["Political causes", "Economic causes", "Social causes", "Immediate trigger vs deep roots"],
                 "conclusion": "Which cause was decisive + linkage." } },
    { "id": "compare", "label": "Compare / contrast",
      "match": ["compare", "contrast", "difference", "differ", "distinguish", " vs ", "versus", "similarit", "approaches of"],
      "demand": "Weigh both along named axes, point by point.",
      "frame": { "intro": "Name both + the basis of comparison.",
                 "body": ["Axis 1 (e.g. ideology)", "Axis 2 (e.g. methods)", "Axis 3 (e.g. outcomes)", "Points of similarity"],
                 "conclusion": "Balanced verdict." } },
    { "id": "evolution", "label": "Trace the evolution",
      "match": ["trace", "evolution", "evolve", "develop", "development", "growth of", "over time", "phases", "stages", "outline of"],
      "demand": "Show the chronological development in phases.",
      "frame": { "intro": "Starting point + what is evolving.",
                 "body": ["Phase 1", "Phase 2", "Phase 3", "Turning points"],
                 "conclusion": "Where it ended up / continuity & change." } },
    { "id": "significance", "label": "Significance / role / contribution",
      "match": ["significance", "role", "contribution", "importance", "relevance", "assess the role", "watershed", "turning point"],
      "demand": "Establish why it mattered, with evidence.",
      "frame": { "intro": "Introduce the subject + claim of significance.",
                 "body": ["Significance 1", "Significance 2", "Significance 3", "Limitations / critiques"],
                 "conclusion": "Overall importance." } },
    { "id": "analyse", "label": "Critically analyse / examine / discuss",
      "match": ["critically", "analyse", "analyze", "examine", "discuss", "evaluate", "to what extent", "do you agree", "comment on", "elaborate"],
      "demand": "Take a balanced position; argue both sides with evidence.",
      "frame": { "intro": "Frame the debate + your line.",
                 "body": ["Arguments for", "Arguments against", "Evidence from the period", "Your reasoned position"],
                 "conclusion": "Nuanced judgement." } }
  ],
  "default": "analyse",
  "note": "Write the answer in your OWN words — these are pointers, not a model answer."
}
