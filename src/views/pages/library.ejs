<div class="page">
  <div class="container">
    <div class="section-head">
      <p class="overline">The full catalogue</p>
      <h1 class="page-title">All books</h1>
      <p class="section-sub">
        <%= totalBooks %> titles · <%= allChapters %> chapters · <%= ncertCount %> of them NCERT.
        Every title is included with lifetime access.
      </p>
    </div>

    <div class="library-toolbar" id="library-toolbar">
      <div class="library-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <label class="sr-only" for="bookSearch">Filter books</label>
        <input id="bookSearch" type="search" placeholder="Filter by title, author or subject…" autocomplete="off" enterkeyhint="search">
      </div>
      <nav class="chip-scroll" id="subjectChips" aria-label="Filter by subject">
        <button type="button" class="chip chip-filter is-active" data-subject="">All</button>
        <% groups.forEach(function (g) { %>
          <button type="button" class="chip chip-filter" data-subject="<%= g.subject %>"><%= g.subject %></button>
        <% }); %>
      </nav>
      <p class="library-result muted" id="resultCount" role="status" aria-live="polite"></p>
    </div>

    <% if (groups.length) { %>
      <% groups.forEach(function (g) { %>
        <section class="library-group" id="<%= g.anchor %>" data-subject-group="<%= g.subject %>">
          <div class="library-group-head">
            <h2><%= g.subject %></h2>
            <span class="library-count" data-group-count><%= g.books.length %> book<%= g.books.length === 1 ? '' : 's' %></span>
          </div>
          <div class="book-grid">
            <% g.books.forEach(function (b) { %>
              <div class="book-card-wrap book-item" data-s="<%= g.subject %>">
                <%- include('partials/book-card', { b: b, subject: g.subject }) %>
                <% if (hasExtras[b.slug]) { %>
                  <a class="book-extras" href="/book/<%= b.slug %>">Study tools
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
                  </a>
                <% } %>
              </div>
            <% }); %>
          </div>
        </section>
      <% }); %>
      <div class="alert alert-info" id="noResults" hidden>No books match that filter. Try a different keyword or subject.</div>
    <% } else { %>
      <div class="alert alert-info">No books are published yet. Please check back soon.</div>
    <% } %>
  </div>
</div>

<script>
(function () {
  var search = document.getElementById('bookSearch');
  if (!search) return;
  var chips = [].slice.call(document.querySelectorAll('#subjectChips .chip-filter'));
  var items = [].slice.call(document.querySelectorAll('.book-item'));
  var groups = [].slice.call(document.querySelectorAll('[data-subject-group]'));
  var count = document.getElementById('resultCount');
  var noRes = document.getElementById('noResults');

  function activeSubject() {
    var on = document.querySelector('#subjectChips .chip-filter.is-active');
    return on ? (on.getAttribute('data-subject') || '') : '';
  }
  function apply() {
    var q = (search.value || '').trim().toLowerCase();
    var subj = activeSubject();
    var visible = 0;
    items.forEach(function (item) {
      var hay = item.querySelector('[data-search]');
      var hay2 = hay ? hay.getAttribute('data-search') : '';
      var ok = (!q || hay2.indexOf(q) !== -1) && (!subj || item.getAttribute('data-s') === subj);
      item.hidden = !ok;
      if (ok) visible++;
    });
    groups.forEach(function (g) {
      g.hidden = g.querySelectorAll('.book-item:not([hidden])').length === 0;
    });
    if (count) {
      count.textContent = visible
        ? (visible === items.length ? visible + ' books' : visible + ' of ' + items.length + ' books')
        : '';
    }
    if (noRes) noRes.hidden = visible > 0;
  }

  search.addEventListener('input', apply);
  search.addEventListener('search', apply);
  chips.forEach(function (c) {
    c.addEventListener('click', function () {
      chips.forEach(function (x) { x.classList.remove('is-active'); });
      c.classList.add('is-active');
      apply();
    });
  });
  apply();
})();

<% if (requestBookEmail) { %>
  <div class="library-request" style="margin-top:var(--sp-8);">
    <h2 class="admin-subhead">Can't find a book?</h2>
    <p class="section-sub">Request it and we'll add it within 48 hours.</p>
    <form id="requestBookForm" style="display:flex;gap:var(--sp-2);flex-wrap:wrap;align-items:center;">
      <input class="library-search-input" id="requestBookTitle" type="text" placeholder="Book title, author or ISBN" required>
      <input type="hidden" id="requestBookEmail" value="<%= requestBookEmail %>">
      <input type="hidden" id="requestBookMessage" value="<%= requestBookMessage %>">
      <button class="btn btn-primary" type="submit">Request</button>
    </form>
  </div>
<% } %>
  var reqForm = document.getElementById('requestBookForm');
  if (reqForm) {
    reqForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var title = document.getElementById('requestBookTitle').value.trim();
      var email = document.getElementById('requestBookEmail').value.trim();
      var message = document.getElementById('requestBookMessage').value.trim();
      if (!title || !email) return;
      var subject = encodeURIComponent('Book request: ' + title);
      var body = encodeURIComponent(message.replace('{title}', title).replace('{email}', email));
      window.location.href = 'mailto:' + encodeURIComponent(email) + '?subject=' + subject + '&body=' + body;
    });
  }
</script>