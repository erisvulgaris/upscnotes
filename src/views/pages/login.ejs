<div class="auth-page">
  <div class="auth-card reveal">
    <span class="auth-badge" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
    </span>
    <h1>Welcome back</h1>
    <p class="muted">Sign in to open your library and pick up where you left off.</p>

    <% if (error) { %>
      <div class="alert alert-error" role="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/login" class="stack" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">

      <label>
        <span>Email</span>
        <input type="email" name="email" id="email" value="<%= email %>" required
               autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false"
               placeholder="you@example.com">
      </label>

      <label>
        <span>Password</span>
        <span class="input-with-toggle">
          <input type="password" name="password" id="pw" required
                 autocomplete="current-password" placeholder="Your password">
          <button type="button" class="pw-toggle" aria-label="Show password" aria-pressed="false">Show</button>
        </span>
      </label>

      <button class="btn btn-primary btn-lg btn-block" type="submit">
        Sign in
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </form>

    <p class="auth-alt muted">
      New here? <a href="/signup<%= next && next !== '/' ? '?next=' + encodeURIComponent(next) : '' %>">Create an account</a>
      <br><span class="tiny">Forgotten password? <a href="mailto:support@upscbooks.shop">Contact support</a>.</span>
    </p>
  </div>
</div>