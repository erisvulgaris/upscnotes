<%
  var ncertBooks  = ncertCount || 0;
  var textbookN  = textbooks ? textbooks.length : 0;
  var subjectList = (typeof subjects !== 'undefined' && subjects) ? subjects : [];
  var spotlightBook = spotlight || null;
  var spotlightTools = spotlightExtras || null;
  // A representative shelf for the hero. Prefer the longest titles so the
  // covers read as substantial books rather than slim pamphlets.
  var shelf = ((typeof shelfBooks !== 'undefined' && shelfBooks) ? shelfBooks : []).slice(0, 4);
  var subjectSamples = (typeof subjectSamples !== 'undefined' && subjectSamples) ? subjectSamples : {};
  var subjectCovers = (typeof subjectCovers !== 'undefined' && subjectCovers) ? subjectCovers : {};
  var ncertShelf = (typeof ncertShelf !== 'undefined' && ncertShelf) ? ncertShelf : [];

  // Per-subject accents. The first list drives the accent bar only; the second
  // is a contrast-checked text colour for the badge on its tint.
  var subjectColors = ['#1E2A52', '#8B2500', '#1565C0', '#00695C', '#2E7D32', '#4A148C', '#B45309', '#0F766E'];
  var subjectTints  = ['#EDEFF8', '#F6EAE4', '#E7EFFA', '#E4F1EF', '#E7F1E8', '#EFE9F6', '#FBF0E2', '#E2F2F0'];
  var subjectInks   = ['#2B3A6B', '#9A3412', '#1D4ED8', '#0F766E', '#15803D', '#6D28D9', '#A15C07', '#0F766E'];
%>
<div class="page home-page">

  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="container hero-split">
      <div class="hero-inner">
        <p class="overline">Civil services preparation library</p>
        <h1 class="hero-title">
          One library for your <span class="hl">entire</span> civil services journey
        </h1>
        <p class="hero-sub">
          NCERT through standard UPSC titles, chapter-wise and searchable — with text-to-speech
          reading, question banks, flashcards and timelines alongside every book.
        </p>

        <div class="hero-cta">
          <% if (user) { %>
            <a class="btn btn-primary btn-lg" href="/dashboard">Open my library</a>
          <% } else { %>
            <a class="btn btn-primary btn-lg" href="/signup">Create a free account</a>
          <% } %>
          <a class="btn btn-ghost btn-lg" href="/library">Browse <%= totalBooks %> books</a>
        </div>

        <ul class="hero-facts" aria-label="Library at a glance">
          <li><b><%= totalBooks %></b> books</li>
          <li><b><%= allChapters %></b> chapters</li>
          <li><b><%= ncertBooks %></b> NCERT</li>
          <li><b><%= subjectList.length %></b> subjects</li>
        </ul>
      </div>

      <!-- The library itself. One title pulled forward, the rest fanned behind
           it: the books are the product, so they get a real size. -->
      <div class="hero-visual">
        <div class="stack" style="--fan-n:<%= Math.min(shelf.length, 4) %>" aria-hidden="true">
          <% shelf.forEach(function (b, i) { %>
            <a class="stack-book <%= i === 0 ? 'is-lead' : '' %>" tabindex="-1"
               href="/read/<%= b.slug %>/1" style="--cover:<%= b.color || '#1E2A52' %>">
              <span class="stack-spine"></span>
              <span class="cover-art">
                <span class="cover-genre"><%= b.category === 'ncert' ? 'NCERT' : 'UPSC' %></span>
                <span class="cover-title"><%= b.title %></span>
                <span class="cover-author"><%= b.author %></span>
              </span>
            </a>
          <% }); %>
        </div>
        <p class="stack-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg>
          <span>Every chapter <b>reads aloud</b> — tap any sentence to start, at your pace.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ============================ SAMPLE ============================ -->
  <% if (sample) { %>
  <section class="section sample-band" id="sample">
    <div class="container sample-grid">
      <div class="sample-page">
        <p class="sample-where">
          <%# The overline is only worth showing when the book title does not
              already lead with the subject: "HISTORY / History (India and…)"
              read as a stutter. %>
          <% var subj = sample.book.subject || ''; %>
          <% if (subj && sample.book.title.toLowerCase().indexOf(subj.toLowerCase()) !== 0) { %>
            <span class="overline"><%= subj %></span>
            <span class="sample-dash" aria-hidden="true">/</span>
          <% } %>
          <span><%= sample.book.title %></span>
        </p>
        <h2 class="sample-title"><%= sample.chapter.title %></h2>
        <p class="sample-meta">
          Chapter <%= sample.chapter.n %> of <%= sample.totalChapters %>
          &middot; <%= sample.book.author %>
          <% if (sample.hasAudio) { %>
            &middot; <span class="sample-audio">reads aloud</span>
          <% } %>
        </p>
        <div class="sample-prose">
          <% sample.paragraphs.forEach(function (p, i) { %>
            <p class="<%= i === 0 ? 'lede' : '' %>"><%= p %></p>
          <% }); %>
          <p class="sample-fade" aria-hidden="true"></p>
        </div>        <div class="sample-actions">
          <a class="btn btn-primary" href="/read/<%= sample.book.slug %>/<%= sample.chapter.n %>">
            Read the chapter
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <p class="sample-note">This is the real text, from the book.</p>
        </div>
      </div>

      <aside class="sample-aside">
        <div class="sample-book">
          <span class="sample-book-cover" style="--cover:<%= sample.book.color || '#1E2A52' %>">
            <span class="cover-art">
              <span class="cover-genre"><%= sample.book.subject ? String(sample.book.subject).toUpperCase() : 'TEXTBOOK' %></span>
              <span class="cover-title"><%= sample.book.title %></span>
            </span>
          </span>
          <span class="sample-book-meta">
            <span class="overline">From the library</span>
            <b><%= sample.book.title %></b>
            <span><%= sample.book.author %></span>
          </span>
        </div>
        <p class="overline">Why it reads better</p>
        <ul class="sample-points">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" width="17" height="17" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            <span>Every chapter is here in full — nothing summarised, nothing abridged.</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" width="17" height="17" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg>
            <span>Tap any sentence to have it read to you, at your own pace.</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" width="17" height="17" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <span>Search the full text and jump straight to the section you need.</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" width="17" height="17" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M12 4v16M2 12h20"/></svg>
            <span><%= allChapters %> chapters across <%= totalBooks %> books, all on one account.</span>
          </li>
        </ul>
        <a class="sample-aside-link" href="/library">
          See the whole shelf
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </aside>
    </div>
  </section>
  <% } %>

  <!-- ============================ SUBJECTS ============================ -->
  <section class="section band-tight" id="subjects">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Start from your subject</h2>
        <p class="section-sub">Every subject in the library, grouped so you can go straight to what you're revising.</p>
      </div>
      <div class="subject-grid">
        <% subjectList.forEach(function (s, i) { %>
          <a class="subject-card reveal" href="/library#<%= s.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>"
             data-si="<%= i %>" style="--d:<%= (i % 4) * 70 + 'ms' %>">
            <span class="subject-card-top">
              <span class="subject-name"><%= s %></span>
              <span class="subject-count"><%= subjectCount[s] %></span>
            </span>
            <% var covers = (subjectCovers[s] || []); %>
            <% if (covers.length) { %>
              <span class="subject-covers" aria-hidden="true">
                <% covers.forEach(function (b) { %>
                  <span class="subject-cover" style="--cover:<%= b.color || '#1E2A52' %>">
                    <span class="cover-genre"><%= b.category === 'ncert' ? 'NCERT' : 'UPSC' %></span>
                    <span class="cover-title"><%= b.title %></span>
                  </span>
                <% }); %>
              </span>
            <% } %>
            <span class="subject-more">
              <%= subjectCount[s] === 1 ? '1 title' : subjectCount[s] + ' titles' %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ============================ SPOTLIGHT ============================ -->
  <% if (spotlightBook) { %>
  <section class="section band-lg" id="spotlight">
    <div class="container">
      <div class="spotlight reveal" style="--spot-color:<%= spotlightBook.color || '#1E2A52' %>">
        <div class="spotlight-art">
          <div class="spotlight-cover">
            <span class="cover-art">
              <span class="cover-genre"><%= spotlightBook.category === 'ncert' ? 'NCERT' : 'UPSC' %> · <%= spotlightBook.subject || 'General' %></span>
              <span class="cover-title"><%= spotlightBook.title %></span>
              <span class="cover-author"><%= spotlightBook.author %></span>
            </span>
          </div>
          <p class="spotlight-caption">Most-read title in the library</p>
        </div>

        <div class="spotlight-body">
          <p class="overline">Featured title</p>
          <h2 class="section-title"><%= spotlightBook.title %></h2>
          <p class="lead" style="margin-top:var(--sp-2);max-width:46ch;">
            <%= spotlightBook.chapter_count %> chapters by <%= spotlightBook.author %>, fully searchable
            and readable aloud — plus practice material built from the book itself.
          </p>

          <% if (spotlightTools && spotlightTools.length) { %>
            <ul class="spotlight-tools">
              <% spotlightTools.forEach(function (t) { %>
                <li>
                  <a href="/book/<%= spotlightBook.slug %>/<%= t.slug %>">
                    <span class="spotlight-tool-ico" aria-hidden="true"><%- t.icon %></span>
                    <span class="spotlight-tool-label"><%= t.label %></span>
                    <span class="spotlight-tool-n"><%= t.count.toLocaleString('en-IN') %> <%= t.unit %></span>
                    <svg class="spotlight-tool-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                  </a>
                </li>
              <% }); %>
            </ul>
          <% } %>

          <div class="row" style="margin-top:var(--sp-5);">
            <a class="btn btn-primary" href="/read/<%= spotlightBook.slug %>/1">Start reading</a>
            <a class="btn btn-ghost" href="/library">All books</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ============================ FEATURES ============================ -->
  <section class="section band-tight" id="features">
    <div class="container">
      <div class="feature-split">
        <div class="section-head">
          <h2 class="section-title">Built for reading, not scrolling</h2>
          <p class="section-sub">
            Every screen here was designed around one job: getting you from a
            chapter to actually understanding it.
          </p>
        </div>
        <ul class="feature-points">
          <li>
            <span class="feature-n">01</span>
            <span class="feature-body">
              <b>The whole book, not a summary of it</b>
              <span><%= allChapters %> chapters across <%= totalBooks %> titles, every one searchable and readable in full.</span>
            </span>
          </li>
          <li>
            <span class="feature-n">02</span>
            <span class="feature-body">
              <b>Hands-free when you want it</b>
              <span>Tap any sentence to start it being read aloud, at a speed you choose.</span>
            </span>
          </li>
          <li>
            <span class="feature-n">03</span>
            <span class="feature-body">
              <b>Find the line you half-remember</b>
              <span>Search the full text and land on the exact section, not a chapter list.</span>
            </span>
          </li>
          <li>
            <span class="feature-n">04</span>
            <span class="feature-body">
              <b>Revise, not just read</b>
              <span>Question banks, flashcards and timelines built from the book itself.</span>
            </span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================ NCERT ============================ -->
  <section class="section band-tight" id="ncert">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">The NCERT shelf, complete</h2>
        <p class="section-sub">
          <%= ncertBooks %> textbooks across History, Geography, Economics, Political Science and
          Social Science — the foundation everything else is built on.
        </p>
      </div>

      <% if (ncertShelf && ncertShelf.length) { %>
        <div class="strip-wrap">
          <div class="chip-scroll ncert-strip reveal" role="list">
          <% ncertShelf.forEach(function (b) { %>
            <a class="ncert-strip-item" role="listitem" href="/read/<%= b.slug %>/1">
              <span class="ncert-strip-cover" style="--cover:<%= b.color || '#1E2A52' %>">
                <span class="cover-art">
                  <span class="cover-genre">NCERT</span>
                  <span class="cover-title"><%= b.title %></span>
                </span>
              </span>
              <span class="ncert-strip-t"><%= b.title %></span>
              <span class="ncert-strip-m"><%= b.chapter_count %> ch</span>
</a>
            <% }); %>
          </div>
        </div>
        <% } %>

      <div class="row" style="margin-top:var(--sp-5);">
        <a class="btn btn-primary" href="/ncerts">Browse all <%= ncertBooks %> NCERTs</a>
        <a class="btn btn-ghost" href="/library#ncert">See them in the library</a>
      </div>
    </div>
  </section>

  <!-- ============================ PRICING ============================ -->
  <section class="section band-lg band-framed" id="pricing">
    <div class="container">
      <div class="pricing-cols">
        <div class="pricing-arg">
          <h2 class="section-title">One payment. Everything, forever.</h2>
          <p class="lead" style="margin-top:var(--sp-3);max-width:46ch;">
            <%= pricing.featureLine %>
          </p>
          <ul class="price-feats" style="max-width:34rem;">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>All <%= totalBooks %> books &mdash; <%= ncertBooks %> NCERT and <%= textbookN %> standard UPSC titles</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><%= allChapters %> chapters and growing</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Text-to-speech reading, full-text search, flashcards and question banks</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><%= pricing.yearly ? 'Billed every 12 months, cancel any time' : 'Any device, any time — phone, tablet or desktop' %></span></li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>7-day money-back guarantee</span></li>
          </ul>

          <div class="pricing-note">
            <h3>What &ldquo;lifetime&rdquo; means</h3>
            <p>
              One payment covers every book in the library today and everything added later.
              There is no renewal date and no per-book charge &mdash; when a new title is
              published it appears in your account automatically.
            </p>
            <p>
              Prefer to look before you pay? Every title is browsable free, and there is a
              7-day money-back guarantee.
            </p>
          </div>
        </div>

        <div class="pricing-wrap">
          <div class="pricing-card reveal">
            <span class="pricing-tag">Lifetime</span>
            <div class="price">
              <span class="price-cur">₹</span><span class="price-num" data-price><%= pricing.rupees %></span>
              <span class="price-per"><%= pricing.terms.cadence %></span>
            </div>
            <% if (pricing.compare) { %><div class="price-old" data-price-strike><%= pricing.compareLabel %></div><% } %>
            <p class="price-alt">
              <%= pricing.note || 'Discount codes are applied at checkout.' %>
            </p>
            <a class="btn btn-gold btn-lg btn-block" style="margin-top:var(--sp-5);" href="/<%= user ? 'checkout' : 'signup' %>">
              <%= user ? 'Get lifetime access' : 'Create account & unlock' %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <p class="price-note muted">UPI &middot; Cards &middot; Netbanking &middot; Secured by Razorpay</p>
          </div>

          <p class="pricing-fine">
            <a href="/terms">Terms</a> &middot; <a href="/refunds">refund policy</a> &middot;
            <a href="/privacy">privacy</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ FAQ ============================ -->
  <section class="section band-tight" id="faq">
    <div class="container faq-grid">
      <div class="faq-intro">
        <p class="overline">Before you decide</p>
        <h2 class="section-title">Questions people ask</h2>
        <p class="lead" style="margin-top:var(--sp-3);max-width:34ch;">
          If something is not answered here, email
          <a href="mailto:support@upscbooks.shop">support@upscbooks.shop</a>
          and a person will answer.
        </p>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>What exactly does lifetime access include?</summary>
          <p>Every book currently in the library — all <%= ncertBooks %> NCERT titles and the <%= textbookN %> standard UPSC books — plus anything added in future, at no extra cost. There is no renewal date.</p>
        </details>
        <details class="faq-item">
          <summary>Can I read on my phone?</summary>
          <p>Yes. Every screen is built mobile-first, and reading progress, search and read-aloud all work the same on a phone as on a desktop.</p>
        </details>
        <details class="faq-item">
          <summary>Will it work if my browser cannot speak?</summary>
          <p>Every chapter also has a recorded narration, used automatically when your device has no speech voice available.</p>
        </details>
        <details class="faq-item">
          <summary>Which books have practice material?</summary>
          <p>Question banks, flashcards, timelines, maps, mains prompts and glossaries are available on the standard UPSC titles. Each book&rsquo;s page shows exactly what it has.</p>
        </details>
        <details class="faq-item">
          <summary>Can I try it before paying?</summary>
          <p>Every title is browsable free, and there is a 7-day money-back guarantee once you have paid.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="section band-lg band-framed" id="start">
    <div class="container">
      <div class="cta reveal">
        <p class="overline">One payment</p>
        <h2 class="cta-title">Start your preparation today</h2>
        <p class="lead cta-sub">
          <%= totalBooks %> books, <%= allChapters %> chapters, every one of them readable aloud.
          Free to make an account — pay when you are ready.
        </p>
        <div class="cta-actions">
          <a class="btn btn-gold btn-lg" href="/<%= user ? 'dashboard' : 'signup' %>">
            <%= user ? 'Open my library' : 'Create a free account' %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a class="btn btn-ghost btn-lg" href="/library">Browse the shelf first</a>
        </div>
        <p class="cta-fine">No renewal &middot; 7-day money-back guarantee &middot; cancel by email</p>
      </div>
    </div>
  </section>
</div>