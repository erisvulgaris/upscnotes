<%
  var totalChapters = 0;
  if (books && books.length) {
    books.forEach(function(b) { totalChapters += b.chapter_count || 0; });
  }
  // pick 3 featured books for carousel — mimic reference: Environment, Indian History, Indian Polity
  var featured = [];
  if (books && books.length) {
    var env = books.find(function(b){ return (b.title||'').toLowerCase().indexOf('environment') !== -1; });
    var hist = books.find(function(b){ return (b.title||'').toLowerCase().indexOf('history') !== -1; });
    var polity = books.find(function(b){ return (b.title||'').toLowerCase().indexOf('polity') !== -1; });
    if (env) featured.push(env);
    if (hist) featured.push(hist);
    if (polity) featured.push(polity);
    // fill up to 3 if not found
    for (var i=0; featured.length < 3 && i < books.length; i++) {
      if (featured.indexOf(books[i]) === -1) featured.push(books[i]);
    }
    featured = featured.slice(0,3);
  }
%>
