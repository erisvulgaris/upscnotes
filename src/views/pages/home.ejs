<%
  var ncertBooks  = ncertCount || 0;
  var textbookN  = textbooks ? textbooks.length : 0;
  var subjectList = subjects || [];
  var spotlightBook = spotlight || null;
  var spotlightTools = spotlightExtras || null;
%>
<div class="page home-page">

  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="container hero-split">
      <div class="hero-inner">
        <p class="overline">Civil services preparation library</p>
        <h1 class="hero-title">
          One library for your <span class="hl">entire</span> civil services journey
        </h1>
        <p class="hero-sub">
          NCERT through standard UPSC titles, chapter-wise and searchable — with text-to-speech
          reading, question banks, flashcards and timelines alongside every book.
        </p>

        <div class="hero-cta">
          <% if (user) { %>
            <a class="btn btn-primary btn-lg" href="/dashboard">Open my library</a>
          <% } else { %>
            <a class="btn btn-primary btn-lg" href="/signup">Create a free account</a>
          <% } %>
          <a class="btn btn-ghost btn-lg" href="/library">Browse <%= totalBooks %> books</a>
        </div>

        <div class="hero-tags">
          <span class="hero-tag"><span class="dot"></span><%= ncertBooks %> NCERT textbooks</span>
          <span class="hero-tag"><span class="dot"></span><%= allChapters %> chapters</span>
          <span class="hero-tag is-accent"><span class="dot"></span>Lifetime access</span>
        </div>
        <p class="hero-proof">One payment. No renewals. Every current and future book in the library.</p>
      </div>

      <!-- Real composition: live library numbers + the product's own features -->
      <div class="hero-visual">
        <div class="hero-card">
          <div class="hero-stat-row">
            <div>
              <div class="hero-stat-v"><%= totalBooks %></div>
              <div class="hero-stat-k">Books</div>
            </div>
            <div>
              <div class="hero-stat-v"><%= allChapters %></div>
              <div class="hero-stat-k">Chapters</div>
            </div>
            <div>
              <div class="hero-stat-v"><%= subjectList.length %></div>
              <div class="hero-stat-k">Subjects</div>
            </div>
          </div>

          <div class="hero-feats">
            <div class="hero-feat">
              <span class="hero-feat-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>
              </span>
              <span>
                <span class="hero-feat-t">Read aloud</span>
                <span class="hero-feat-d">Sentence-level text-to-speech with word highlighting, speed control and voice selection.</span>
              </span>
            </div>
            <div class="hero-feat">
              <span class="hero-feat-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" width="18" height="18"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              </span>
              <span>
                <span class="hero-feat-t">Search inside every book</span>
                <span class="hero-feat-d">Full-text search across chapters, with results that jump straight to the section.</span>
              </span>
            </div>
            <div class="hero-feat">
              <span class="hero-feat-ico is-gold" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M12 4v16M2 12h20"/></svg>
              </span>
              <span>
                <span class="hero-feat-t">Revise with practice sets</span>
                <span class="hero-feat-d">Question banks, flashcards, timeline, maps and mains prompts per book.</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ STATS ============================ -->
  <section class="section" style="padding-block:var(--sp-8);">
    <div class="container">
      <div class="stats-band reveal">
        <div class="stat-cell"><div class="stat-cell-v"><%= totalBooks %></div><div class="stat-cell-k">Books live</div></div>
        <div class="stat-cell"><div class="stat-cell-v"><%= allChapters %></div><div class="stat-cell-k">Chapters</div></div>
        <div class="stat-cell"><div class="stat-cell-v"><%= ncertBooks %></div><div class="stat-cell-k">NCERT titles</div></div>
        <div class="stat-cell"><div class="stat-cell-v"><%= subjectList.length %></div><div class="stat-cell-k">Subjects</div></div>
      </div>
    </div>
  </section>

  <!-- ============================ SUBJECTS ============================ -->
  <section class="section" id="subjects">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Start from your subject</h2>
        <p class="section-sub">Every subject in the library, grouped so you can go straight to what you're revising.</p>
      </div>
      <div class="feature-grid">
        <% subjectList.forEach(function (s) { %>
          <a class="feature-card reveal" href="/library#<%= s.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>">
            <span class="feature-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </span>
            <h3><%= s %></h3>
            <p class="muted tiny"><%= subjectCount[s] %> book<%= subjectCount[s] === 1 ? '' : 's' %></p>
          </a>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ============================ SPOTLIGHT ============================ -->
  <% if (spotlightBook) { %>
  <section class="section" id="spotlight">
    <div class="container">
      <div class="feature-grid" style="align-items:center;">
        <div class="hero-card reveal" style="padding:0;overflow:hidden;">
          <div class="book-cover" style="--cover:<%= spotlightBook.color || '#1E2A52' %>; aspect-ratio: 4/3; border-radius:0;">
            <div class="cover-art">
              <span class="cover-genre"><%= spotlightBook.category === 'ncert' ? 'NCERT' : 'UPSC' %> · <%= spotlightBook.subject || 'General' %></span>
              <span class="cover-title" style="font-size:1.5rem;"><%= spotlightBook.title %></span>
              <span class="cover-author"><%= spotlightBook.author %></span>
            </div>
          </div>
        </div>
        <div style="grid-column:span 3;">
          <p class="overline">Featured title</p>
          <h2 class="section-title" style="margin-block:var(--sp-2) var(--sp-3);"><%= spotlightBook.title %></h2>
          <p class="lead" style="max-width:52ch;">
            <%= spotlightBook.chapter_count %> chapters, fully searchable and readable aloud — the most
            used title in the library.
          </p>
          <% if (spotlightTools) { %>
            <div class="tools-grid" style="margin-top:var(--sp-5);grid-template-columns:repeat(2,1fr);">
              <% spotlightTools.forEach(function (t) { %>
                <a class="tool-card" href="/book/<%= spotlightBook.slug %>/<%= t.slug %>">
                  <span class="tool-ico" aria-hidden="true"><%- t.icon %></span>
                  <h3><%= t.label %></h3>
                  <span class="tool-n"><%= t.count %></span>
                </a>
              <% }); %>
            </div>
          <% } %>
          <div class="row" style="margin-top:var(--sp-5);">
            <a class="btn btn-primary" href="/read/<%= spotlightBook.slug %>/1">Start reading</a>
            <a class="btn btn-ghost" href="/library">All books</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ============================ FEATURES ============================ -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-head center">
        <h2 class="section-title">Built for reading, not scrolling</h2>
        <p class="section-sub">Every screen is designed around one job: getting an aspirant from a chapter to understanding it.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal">
          <span class="feature-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </span>
          <h3>Complete books</h3>
          <p>Every chapter present and navigable — no summaries standing in for the real text.</p>
        </div>
        <div class="feature-card reveal">
          <span class="feature-ico is-gold" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg>
          </span>
          <h3>Hands-free reading</h3>
          <p>Tap any sentence to start text-to-speech from that exact point, at your own pace.</p>
        </div>
        <div class="feature-card reveal">
          <span class="feature-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" width="20" height="20"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </span>
          <h3>Find anything fast</h3>
          <p>Full-text search inside each book, plus library-wide search across titles and authors.</p>
        </div>
        <div class="feature-card reveal">
          <span class="feature-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
          </span>
          <h3>Revise properly</h3>
          <p>Question banks, flashcards, timelines, maps and mains prompts on the standard titles.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ NCERT ============================ -->
  <section class="section" id="ncert">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">The NCERT shelf, complete</h2>
        <p class="section-sub">
          <%= ncertBooks %> textbooks across History, Geography, Economics, Political Science and
          Social Science — the foundation everything else is built on.
        </p>
      </div>
      <div class="row" style="margin-bottom:var(--sp-5);">
        <a class="btn btn-primary" href="/ncerts">Browse all NCERTs</a>
        <a class="btn btn-ghost" href="/library#ncert">See them in the library</a>
      </div>
    </div>
  </section>

  <!-- ============================ PRICING ============================ -->
  <section class="section" id="pricing">
    <div class="container">
      <div class="checkout-cols">
        <div>
          <h2 class="section-title">One payment. Everything, forever.</h2>
          <p class="lead" style="margin-top:var(--sp-3);max-width:46ch;">
            Lifetime access covers every book in the library today and everything added later.
            No subscription, no renewal, no per-book charges.
          </p>
          <ul class="price-feats" style="max-width:34rem;">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>All <%= totalBooks %> books — <%= ncertBooks %> NCERT and <%= textbookN %> standard UPSC titles</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><%= allChapters %> chapters and growing</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Text-to-speech reading, full-text search, flashcards and question banks</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Any device, any time — phone, tablet or desktop</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>7-day money-back guarantee</span></li>
          </ul>
        </div>

        <div class="pricing-wrap">
          <div class="pricing-card">
            <span class="pricing-tag">Lifetime</span>
            <div class="price">
              <span class="price-cur">₹</span><span class="price-num">999</span>
              <span class="price-per">one-time</span>
            </div>
            <div class="price-old">₹1,199 launch price</div>
            <a class="btn btn-gold btn-lg btn-block" style="margin-top:var(--sp-5);" href="/<%= user ? 'checkout' : 'signup' %>">
              <%= user ? 'Get lifetime access' : 'Create account & unlock' %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <p class="price-note muted">UPI · Cards · Netbanking · Secured by Razorpay</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ FAQ ============================ -->
  <section class="section" id="faq">
    <div class="container" style="max-width:46rem;">
      <div class="section-head center">
        <h2 class="section-title">Questions people ask</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>What exactly does lifetime access include?</summary>
          <p>Every book currently in the library — all NCERT titles and the standard UPSC books — plus everything added in future, at no extra cost. There is no renewal date.</p>
        </details>
        <details class="faq-item">
          <summary>Can I read on my phone?</summary>
          <p>Yes. Every screen is built mobile-first, and reading progress, search and text-to-speech all work the same on a phone as on a desktop.</p>
        </details>
        <details class="faq-item">
          <summary>Does text-to-speech work offline?</summary>
          <p>Text-to-speech uses your device's built-in speech engine, so it works without a connection once a chapter is loaded. Voices and speed are both selectable.</p>
        </details>
        <details class="faq-item">
          <summary>Which books have practice material?</summary>
          <p>Question banks, flashcards, timelines, maps, mains prompts and glossaries are available on the standard UPSC titles. Availability per book is shown on its study-tools page.</p>
        </details>
        <details class="faq-item">
          <summary>What if it isn't working for me?</summary>
          <p>You have a 7-day money-back guarantee. Email support@upscbooks.shop and we'll refund it.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ============================ CTA ============================ -->
  <section class="section" style="padding-block:var(--sp-8);">
    <div class="container">
      <div class="cta-band reveal">
        <div>
          <h2>Start your preparation today</h2>
          <p>Free to create an account. Unlock the whole library whenever you're ready.</p>
        </div>
        <a class="btn btn-gold btn-lg" href="/<%= user ? 'dashboard' : 'signup' %>">
          <%= user ? 'Open my library' : 'Create a free account' %>
        </a>
      </div>
    </div>
  </section>
</div>