<%
  // Only render subject sections that actually have books, in the order the
  // route grouped them, and drive the filter from one chip row.
  var order = [];
  for (var k in subjects) {
    if (Object.prototype.hasOwnProperty.call(subjects, k) && subjects[k] && subjects[k].length) order.push(k);
  }
  var preferred = ['History', 'Geography', 'Economics', 'Political Science', 'Social Science'];
  order.sort(function (a, b) {
    var ia = preferred.indexOf(a), ib = preferred.indexOf(b);
    if (ia !== -1 || ib !== -1) return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
    return a.localeCompare(b);
  });
%>
<div class="page">
  <div class="container">
    <div class="section-head">
      <p class="overline">The foundation</p>
      <h1 class="page-title">NCERT Textbooks</h1>
      <p class="section-sub">
        <%= ncertCount %> textbooks · <%= allChapters %> chapters across
        <%= order.length %> subjects. Every one is included with lifetime access.
      </p>
    </div>

    <% if (order.length) { %>
      <div class="library-toolbar">
        <div class="chip-scroll" role="group" aria-label="Filter by subject" data-filter-group>
          <button type="button" class="chip chip-filter is-active" data-filter="all">All</button>
          <% order.forEach(function (s) { %>
            <button type="button" class="chip chip-filter" data-filter="<%= s %>"><%= s %></button>
          <% }); %>
        </div>
        <p class="library-result muted"><%= ncertCount %> books · <%= allChapters %> chapters</p>
      </div>

      <% order.forEach(function (subj) { %>
        <% var books = subjects[subj]; %>
        <section class="library-group" data-filter-target="<%= subj %>">
          <div class="library-group-head">
            <h2><%= subj %></h2>
            <span class="library-count"><%= books.length %> book<%= books.length === 1 ? '' : 's' %></span>
          </div>
          <div class="book-grid">
            <% books.forEach(function (b) { %>
              <%- include('partials/book-card', { b: b, subject: subj }) %>
            <% }); %>
          </div>
        </section>
      <% }); %>
    <% } else { %>
      <div class="alert alert-info">No NCERT titles have been published yet.</div>
    <% } %>

    <div class="row" style="margin-top:var(--sp-12);">
      <a class="btn btn-ghost" href="/library">See the whole library</a>
      <a class="btn btn-primary" href="/<%= user ? 'dashboard' : 'signup' %>">
        <%= user ? 'Open my library' : 'Create a free account' %>
      </a>
    </div>
  </div>
</div>