<div class="page">
  <div class="container" style="padding: var(--space-16) 0; max-width: 560px;">
    <div class="pricing-card" style="text-align:center;">
      <h2 style="font-family:var(--font-display);margin:0 0 8px;">This is a member-only library</h2>
      <p class="muted" style="margin:0 0 20px;">
        <%= book ? '“' + book.title + '”' : 'This content' %> is available to lifetime members.
        Unlock every book — current and future — with a single ₹999 payment, or apply code <strong>UPSC299</strong> to pay just ₹299.
      </p>
      <a class="btn btn-gold btn-lg" href="/checkout">Get lifetime access →</a>
    </div>
  </div>
</div>