<div class="page">
  <div class="container" style="max-width:52rem;">
    <div class="section-head">
      <p class="overline">Library search</p>
      <h1 class="page-title"><%= searched ? 'Results' : 'Search the library' %></h1>
      <% if (searched) { %>
        <p class="section-sub" role="status" aria-live="polite">
          <%= results.length %> match<%= results.length === 1 ? '' : 'es' %> for
          &ldquo;<%= q %>&rdquo; across <%= totalBooks %> titles.
        </p>
      <% } else { %>
        <p class="section-sub">Search <%= totalBooks %> titles by name, author or subject.</p>
      <% } %>
    </div>

    <form class="library-toolbar" action="/search" method="get" role="search">
      <div class="library-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <label class="sr-only" for="sq">Search books</label>
        <input id="sq" type="search" name="q" value="<%= q %>" placeholder="History, polity, economics…" autocomplete="off" enterkeyhint="search">
      </div>
      <button class="btn btn-primary" type="submit">Search</button>
    </form>

    <% if (results.length) { %>
      <div class="book-grid">
        <% results.forEach(function (b) { %>
          <%- include('partials/book-card', { b: b, subject: b.subject || 'General' }) %>
        <% }); %>
      </div>
    <% } else if (searched) { %>
      <div class="alert alert-info">
        Nothing matched &ldquo;<%= q %>&rdquo;. Try a single keyword — &ldquo;history&rdquo;,
        &ldquo;polity&rdquo;, &ldquo;geography&rdquo; or &ldquo;economy&rdquo;.
      </div>
      <div class="row" style="margin-top:var(--sp-5);">
        <a class="btn btn-ghost" href="/library">Browse all books</a>
        <a class="btn btn-ghost" href="/ncerts">Browse NCERT</a>
      </div>
    <% } else { %>
      <div class="feature-grid">
        <% ['History','Polity','Geography','Economics','Environment'].forEach(function (s) { %>
          <a class="feature-card" href="/search?q=<%= encodeURIComponent(s) %>">
            <span class="feature-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
            <h3><%= s %></h3>
            <p class="muted tiny">Search titles matching &ldquo;<%= s.toLowerCase() %>&rdquo;</p>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<script>
(function () {
  var input = document.getElementById('sq');
  if (!input) return;
  input.focus();
  if (input.value) { input.setSelectionRange(input.value.length, input.value.length); }
})();
</script>