<div class="page">
  <div class="container checkout-cols">
    <div>
      <div class="section-head">
        <p class="overline">Checkout</p>
        <h1 class="page-title">Lifetime access, one payment</h1>
        <p class="section-sub">Pay securely through Razorpay. Your library unlocks the moment payment clears.</p>
      </div>

      <div class="stack" style="max-width:34rem;margin-top:var(--sp-6);">
        <h2 class="card-title">What's included</h2>
        <ul class="price-feats">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>All <%= totalBooks %> books — <%= ncertCount %> NCERT and the standard UPSC titles</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><%= totalChapters %> chapters, with new titles added over time</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Text-to-speech reading, full-text search and practice material</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Any device, any time — no renewal, ever</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>7-day money-back guarantee</span></li>
        </ul>
        <p class="muted small">
          Prefer to try first? Open any book in the <a href="/library">library</a> — every title is
          browsable before you pay.
        </p>
      </div>
    </div>

    <div class="pricing-wrap">
      <div class="pricing-card reveal">
        <span class="pricing-tag">Lifetime</span>

        <div class="price">
          <span class="price-cur">₹</span><span class="price-num" data-price>999</span>
          <span class="price-per">one-time</span>
        </div>
        <div class="price-old" data-price-strike>₹1,199 launch price</div>

        <button class="btn btn-gold btn-lg btn-block" id="rzp-checkout" type="button" style="margin-top:var(--sp-5);">
          <span data-pay-label-text>Pay ₹999 and unlock now</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>

        <%- include('partials/coupon') %>

        <div id="checkout-msg" class="alert" style="margin-top:var(--sp-4);" role="status" hidden></div>

        <p class="price-note muted">
          UPI · Cards · Netbanking · Secured by Razorpay
        </p>
        <p class="tiny muted center" style="margin-top:var(--sp-3);">
          Read our <a href="/terms">terms</a> and <a href="/refunds">refund policy</a>.
        </p>
      </div>
    </div>
  </div>
</div>