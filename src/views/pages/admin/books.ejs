<div class="page">
  <div class="container" style="padding-top: var(--space-12);">
    <div class="section-head">
      <p class="admin-eyebrow">Admin</p>
      <h1 style="font-family:var(--font-display);font-size:var(--text-2xl);margin:0 0 4px;">Books</h1>
      <p class="muted">Imported titles and their chapter counts.</p>
    </div>

    <%- include('../partials/admin-nav', { active }) %>

    <table class="admin-table">
      <thead><tr><th>Book</th><th>Slug</th><th>Chapters</th><th>Status</th><th>Added</th></tr></thead>
      <tbody>
        <% books.forEach(function (b) { %>
          <tr>
            <td class="cell-strong"><%= b.title %></td>
            <td class="mono"><%= b.slug %></td>
            <td><%= b.chapter_count %></td>
            <td><span class="badge badge-<%= b.status %>"><%= b.status %></span></td>
            <td class="muted"><%= b.created_at %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% if (!books.length) { %>
      <div class="alert alert-info">No books imported yet.</div>
    <% } %>
  </div>
</div>