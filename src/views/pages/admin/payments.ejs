<div class="page">
  <div class="container">
    <div class="section-head">
      <p class="admin-eyebrow">Admin</p>
      <h1 class="page-title">Payments</h1>
      <p class="section-sub">Every payment order and its capture status.</p>
    </div>

    <%- include('../partials/admin-nav', { active: active }) %>

    <% if (payments.length) { %>
      <div class="table-scroll">
        <table class="admin-table">
          <thead>
            <tr><th scope="col">Order</th><th scope="col">Payment</th><th scope="col">User</th><th scope="col">Amount</th><th scope="col">Status</th><th scope="col">When</th></tr>
          </thead>
          <tbody>
            <% payments.forEach(function (p) { %>
              <tr>
                <td class="mono"><%= p.razorpay_order_id %></td>
                <td class="mono"><%= p.razorpay_payment_id || '—' %></td>
                <td>#<%= p.user_id %></td>
                <td><%= RUPEE(p.amount_paise) %></td>
                <td><span class="badge badge-<%= p.status %>"><%= p.status %></span></td>
                <td class="muted tiny"><%= p.created_at %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert alert-info">No payments recorded yet.</div>
    <% } %>
  </div>
</div>