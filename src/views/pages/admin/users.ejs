<div class="page">
  <div class="container">
    <div class="section-head">
      <p class="admin-eyebrow">Admin</p>
      <h1 class="page-title">Members</h1>
      <p class="section-sub">Grant or revoke lifetime access for any account.</p>
    </div>

    <%- include('../partials/admin-nav', { active: active }) %>

    <form method="get" action="/admin/users" class="admin-search" style="margin-top:var(--sp-4);">
      <input type="search" name="q" value="<%= q || '' %>" placeholder="Search by email or name…" autocomplete="off">
      <button class="btn btn-ghost btn-sm" type="submit">Search</button>
      <% if (q) { %><a class="btn btn-ghost btn-sm" href="/admin/users">Clear</a><% } %>
    </form>

    <% if (users.length) { %>
      <div class="table-scroll">
        <table class="admin-table">
          <thead>
            <tr><th scope="col">User</th><th scope="col">Role</th><th scope="col">Access</th><th scope="col">Joined</th><th scope="col"><span class="sr-only">Actions</span></th></tr>
          </thead>
            <tbody>
            <% users.forEach(function (u) { %>
              <tr>
                <td>
                  <a class="cell-strong" href="/admin/users/<%= u.id %>"><%= u.name || u.email %></a>
                  <div class="muted mono"><%= u.email %></div>
                </td>
                <td><span class="badge badge-<%= u.role %>"><%= u.role %></span></td>
                <td>
                  <% if (u.active_sub) { %>
                    <span class="badge badge-active">Active</span>
                  <% } else { %>
                    <span class="badge badge-none">None</span>
                  <% } %>
                </td>
                <td class="muted tiny"><%= u.created_at %></td>
                <td class="cell-actions">
                  <% if (u.active_sub) { %>
                    <form method="post" action="/admin/users/<%= u.id %>/revoke"
                          onsubmit="return confirm('Revoke lifetime access for <%= u.email %>?')">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <button class="btn btn-danger btn-sm" type="submit">Revoke</button>
                    </form>
                  <% } else if (u.role !== 'admin') { %>
                    <form method="post" action="/admin/users/<%= u.id %>/grant">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <button class="btn btn-ghost btn-sm" type="submit">Grant access</button>
                    </form>
                  <% } else { %>
                    <span class="muted tiny">—</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert alert-info">No members yet.</div>
    <% } %>
  </div>
</div>