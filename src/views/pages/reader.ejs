<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= chapter.title %> · <%= book.title %></title>
  <meta name="description" content="<%= book.title %>, chapter <%= chapter.number %>: <%= chapter.title %>. Read online with text-to-speech.">
  <meta name="csrf" content="<%= csrf %>">
  <meta name="theme-color" content="#1E2A52">
  <meta name="robots" content="noindex">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/Cambay-400-0.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/reader.css">
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('upscbooks-theme');
        var theme = saved === 'dark' || saved === 'light' ? saved
          : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        var f = localStorage.getItem('upscbooks-font-scale');
        if (f) document.documentElement.style.setProperty('--font-scale', f);
      } catch (e) {}
    })();
  </script>
</head>
<body class="reading">
  <a class="skip-link" href="#rd-body">Skip to chapter text</a>
  <div class="rd-progress" id="rd-progress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>

  <nav class="rd-nav">
    <div class="container rd-nav-inner">
      <a class="rd-navbtn" href="/dashboard" aria-label="Back to my library" title="My library">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>

      <button class="rd-navbtn" id="ch-open" type="button" aria-label="Open chapter list" aria-expanded="false" aria-controls="ch-sheet">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="20" height="20" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>

      <span class="rd-title">
        <b><%= book.title %></b>
        <span>Ch <%= chapter.number %>: <%= chapter.title %></span>
      </span>

      <span class="rd-tools">
        <button class="rd-navbtn" id="font-toggle" type="button" aria-label="Change text size" title="Text size">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><path d="M4 7V5h16v2M12 5v14M9 19h6"/></svg>
        </button>
        <a class="rd-navbtn" href="/book/<%= book.slug %>" aria-label="Study tools for this book" title="Study tools">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        </a>
      </span>
    </div>
  </nav>

  <!-- Chapter sheet: bottom sheet on phones, side panel from 900px -->
  <div class="ch-sheet" id="ch-sheet" role="dialog" aria-modal="true" aria-label="Chapters">
    <div class="ch-sheet-backdrop" data-sheet-close></div>
    <div class="ch-sheet-panel">
      <div class="ch-sheet-grip" aria-hidden="true"></div>
      <div class="ch-sheet-head">
        <strong><%= book.title %></strong>
        <span class="ch-sheet-progress"><%= chapter.number %> of <%= chapters.length %></span>
        <button class="rd-navbtn" type="button" data-sheet-close aria-label="Close chapter list">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="20" height="20" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="ch-sheet-search">
        <label class="sr-only" for="ch-search">Search inside this book</label>
        <input id="ch-search" type="search" placeholder="Search this book…" autocomplete="off">
      </div>
      <div class="ch-sheet-scroll">
        <nav id="ch-list" aria-label="Chapter list">
          <% chapters.forEach(function (c) { %>
            <a class="ch-item" data-n="<%= c.number %>" data-title="<%= c.title.toLowerCase() %>"
               href="/read/<%= book.slug %>/<%= c.number %>"
               <%= c.number === chapter.number ? 'aria-current="true"' : '' %>>
              <span class="ch-item-n">CHAPTER <%= c.number %></span>
              <span><%= c.title %></span>
            </a>
          <% }); %>
        </nav>
        <div id="ch-results"></div>
      </div>
    </div>
  </div>

  <main class="reader" id="rd-body"
        data-slug="<%= book.slug %>"
        data-chapter="<%= chapter.number %>"
        data-last="<%= chapters.length ? chapters[chapters.length - 1].number : chapter.number %>">
    <div class="rd-body">
      <p class="overline rd-eyebrow">Chapter <%= chapter.number %> · <%= book.subject || 'General' %></p>
      <h1 class="rd-chtitle"><%= chapter.title %></h1>
      <p class="rd-sub">
        <%= book.title %> &middot; Chapter <%= chapter.number %> of <%= chapters.length %>
        &middot; <%= sentenceCount %> paragraphs
        <% if (hasNarration) { %>
          &middot;
          <span class="rd-audio" title="This chapter also has a pre-recorded narration, used automatically if your browser has no speech voice.">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="13" height="13" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg>
            audio available
          </span>
        <% } %>
      </p>

      <%- readerBody %>

      <div class="rd-load" id="rd-load" aria-live="polite">
        <span id="rd-load-text">Scroll on to continue reading</span>
      </div>

      <div class="rd-end">
        <% if (next) { %>
          <a class="btn btn-primary btn-lg btn-block" href="/read/<%= book.slug %>/<%= next.number %>">
            Next: <%= next.title %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        <% } else { %>
          <p class="muted center">You have reached the end of <%= book.title %>.</p>
        <% } %>
        <a class="btn btn-ghost btn-block" href="/dashboard">Back to my library</a>
      </div>
    </div>
  </main>

  <!-- Figure lightbox -->
  <div class="rd-lb" id="rd-lb" role="dialog" aria-modal="true" aria-label="Figure" hidden>
    <button class="rd-lb-close" id="rd-lb-close" type="button" aria-label="Close image">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="20" height="20" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <figure>
      <img id="rd-lb-img" alt="">
      <figcaption id="rd-lb-cap"></figcaption>
    </figure>
  </div>

  <!-- Bookmarks + notes panel -->
  <button class="rd-study-fab" id="rd-study-open" type="button" aria-label="Bookmarks and notes" title="Bookmarks and notes">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="20" height="20" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
  </button>
  <div class="rd-study" id="rd-study" hidden>
    <div class="rd-study-head">
      <h2 class="rd-study-title">Study</h2>
      <div class="rd-study-tabs" role="tablist">
        <button class="rd-study-tab is-active" role="tab" aria-selected="true" data-tab="bookmarks">Bookmarks</button>
        <button class="rd-study-tab" role="tab" aria-selected="false" data-tab="notes">Notes</button>
      </div>
      <button class="rd-study-close" id="rd-study-close" type="button" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="20" height="20" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="rd-study-body">
      <div class="rd-study-pane" id="pane-bookmarks">
        <form class="rd-study-form" id="bm-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="chapter" value="<%= chapter.number %>">
          <input type="hidden" name="audioMs" value="0">
          <input type="hidden" name="scrollPct" value="0">
          <input class="rd-study-input" type="text" name="label" placeholder="Bookmark label" maxlength="200" required>
          <button class="btn btn-primary btn-sm" type="submit">Add bookmark</button>
        </form>
        <div class="rd-study-list" id="bm-list"></div>
      </div>
      <div class="rd-study-pane" id="pane-notes" hidden>
        <form class="rd-study-form" id="note-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="chapter" value="<%= chapter.number %>">
          <input type="hidden" name="audioMs" value="0">
          <input type="hidden" name="scrollPct" value="0">
          <textarea class="rd-study-input" name="body" rows="3" placeholder="Your note" maxlength="8000" required></textarea>
          <div class="rd-study-actions">
            <button class="btn btn-primary btn-sm" type="submit">Save note</button>
            <button class="btn btn-ghost btn-sm" type="button" id="note-export">Export Markdown</button>
          </div>
        </form>
        <div class="rd-study-list" id="note-list"></div>
      </div>
    </div>
  </div>

  <!-- Theme toggle -->
  <button class="rd-theme-toggle" id="rd-theme" type="button" aria-label="Toggle reading theme" title="Toggle reading theme">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
  </button>

  <!-- Audio player dock (recorded narration primary, Web Speech fallback). -->
  <div class="tts-dock" id="tts-dock" hidden>
    <div class="tts-main">
      <button class="tts-btn tts-btn-primary" id="tts-play" type="button" aria-label="Play" title="Play">
        <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
      </button>
      <button class="tts-btn tts-step" id="tts-prev-ch" type="button" aria-label="Previous chapter" title="Previous chapter">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M6 6h2v12H6zM16 6v12l-8-6z"/></svg>
      </button>
      <button class="tts-btn tts-step" id="tts-prev" type="button" aria-label="Back 10 seconds" title="Back 10 seconds (K)">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M12.5 8c-2.65 0-5.05 1-6.9 2.6L2 7v9h9l-2.63-2.63C9.8 12.54 11.07 12 12.5 12c3.17 0 5.96 1.58 7.62 4H20v2h-5v1h2.5c-1.2 2.87-3.88 5-7.5 5a8.96 8.96 0 0 1-3.55-.72L6.8 20.4A10.96 10.96 0 0 0 12.5 22c6.08 0 11.15-4.3 12.26 10h2.24V7.2H22.5C21.35 3.3 17.13 0 12.5 0z"/></svg>
      </button>
      <button class="tts-btn tts-step" id="tts-next" type="button" aria-label="Forward 10 seconds" title="Forward 10 seconds (J)">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M11.5 16c2.65 0 5.05-1 6.9-2.6L22 17V8h-9l2.63 2.63C14.2 12.46 12.93 13 11.5 13c-3.17 0-5.96-1.58-7.62-4H4V7h5v-1H6.5C7.7 3.3 11.92 0 16.5 0c6.08 0 11.15 4.3 12.26 10h-2.24v9.8H7.5C8.65 23.7 12.87 27 17.5 27z"/></svg>
      </button>
      <button class="tts-btn tts-step" id="tts-next-ch" type="button" aria-label="Next chapter" title="Next chapter">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M16 18h2v-6h-2v6zM8 18h2v-6H8v6zM6 7l8-6v12l-8-6v18h16V7H6z"/></svg>
      </button>
      <span class="tts-info">
        <span class="tts-now" id="tts-now">Ready</span>
        <span class="tts-times"><span id="tts-cur">0:00</span> / <span id="tts-dur">0:00</span></span>
        <span class="tts-track"><input type="range" id="tts-seek" class="tts-seek" min="0" max="1000" value="0" step="1" aria-label="Seek"></span>
      </span>
      <span class="tts-pos" id="tts-pos"></span>
      <button class="tts-btn" id="tts-mute" type="button" aria-label="Mute" title="Mute">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="16" height="16" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5zM15.5 8.5a5 5 0 0 1 0 7"/></svg>
      </button>
      <button class="tts-btn" id="tts-stop" type="button" aria-label="Stop" title="Stop (S)">
        <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
      </button>
      <button class="tts-btn" id="tts-toggle" type="button" aria-label="Options" aria-expanded="false" title="Options (T)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="20" height="20" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

    <div class="tts-panel" id="tts-panel">
      <div class="tts-panel-row">
        <label>Speed</label>
        <span class="tts-rates" role="group" aria-label="Playback speed">
          <button class="tts-rate" type="button" data-rate="0.75" aria-pressed="false">0.75&times;</button>
          <button class="tts-rate" type="button" data-rate="1" aria-pressed="true">1&times;</button>
          <button class="tts-rate" type="button" data-rate="1.25" aria-pressed="false">1.25&times;</button>
          <button class="tts-rate" type="button" data-rate="1.5" aria-pressed="false">1.5&times;</button>
          <button class="tts-rate" type="button" data-rate="2" aria-pressed="false">2&times;</button>
        </span>
      </div>
      <div class="tts-panel-row">
        <label for="tts-font">Text size</label>
        <span class="tts-rates" role="group" aria-label="Text size">
          <button class="tts-rate" type="button" data-scale="0.9">S</button>
          <button class="tts-rate" type="button" data-scale="1">M</button>
          <button class="tts-rate" type="button" data-scale="1.15">L</button>
          <button class="tts-rate" type="button" data-scale="1.3">XL</button>
        </span>
      </div>
      <div class="tts-panel-row">
        <label>Behaviour</label>
        <span class="tts-rates">
          <button class="tts-switch" id="tts-autoscroll" type="button" aria-pressed="true">Follow along</button>
          <button class="tts-switch" id="tts-autochap" type="button" aria-pressed="true">Auto next chapter</button>
        </span>
      </div>
      <div class="tts-panel-row">
        <span class="tts-shortcuts">
          <kbd>Space</kbd> play/pause · <kbd>←</kbd>/<kbd>→</kbd> ±10 s · <kbd>T</kbd> options · <kbd>S</kbd> stop
        </span>
      </div>
    </div>
  </div>

  <script>
    window.UPSCBOOKS = {
      slug: "<%= book.slug %>",
      title: <%- JSON.stringify(book.title) %>,
      chapter: <%= chapter.number %>,
      last: <%= chapters.length ? chapters[chapters.length - 1].number : chapter.number %>,
      sentences: <%= sentenceCount %>
    };
  </script>
  <script src="/js/reader.js" defer></script>
  <script src="/js/tts.js" defer></script>
  <!-- Loads only when the Web Speech API has no usable voice. -->
  <script src="/js/audio-fallback.js" defer></script>
</body>
</html>