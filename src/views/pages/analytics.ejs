<div class="page">
  <div class="container">
    <div class="section-head">
      <p class="overline">Analytics</p>
      <h1 class="page-title">Your reading stats</h1>
    </div>

    <div class="dash-stats">
      <div class="dash-stat">
        <span class="dash-stat-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </span>
        <span class="dash-stat-v"><%= stats.totalBooks %></span>
        <span class="dash-stat-k">Total books</span>
      </div>
      <div class="dash-stat">
        <span class="dash-stat-ico is-gold" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </span>
        <span class="dash-stat-v"><%= stats.booksStarted %></span>
        <span class="dash-stat-k">Books started</span>
      </div>
      <div class="dash-stat">
        <span class="dash-stat-ico is-success" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <span class="dash-stat-v"><%= stats.completedBooks %></span>
        <span class="dash-stat-k">Completed</span>
      </div>
      <div class="dash-stat">
        <span class="dash-stat-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        </span>
        <span class="dash-stat-v"><%= stats.chaptersRead %></span>
        <span class="dash-stat-k">Chapters read</span>
      </div>
      <div class="dash-stat">
        <span class="dash-stat-ico is-gold" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
        <span class="dash-stat-v"><%= stats.timeStr %></span>
        <span class="dash-stat-k">Audio time</span>
      </div>
    </div>

    <div class="row" style="margin-top:var(--sp-6);">
      <a class="btn btn-ghost" href="/revision">Go to revision</a>
      <a class="btn btn-ghost" href="/dashboard">Back to library</a>
    </div>
  </div>
</div>
