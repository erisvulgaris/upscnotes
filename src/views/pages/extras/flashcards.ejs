<div class="page">
  <%- include('_nav') %>
  <div class="container ex-pad">
    <div class="section-head">
      <p class="overline">Revise</p>
      <h1 class="page-title">Flashcards</h1>
      <p class="section-sub" id="fc-count" role="status" aria-live="polite">Loading cards&hellip;</p>
    </div>

    <div class="ex-filters">
      <label class="sr-only" for="fc-ch">Filter by chapter</label>
      <select id="fc-ch">
        <option value="">All chapters</option>
        <% chapters.forEach(function (c) { %>
          <option value="<%= c.number %>">Ch <%= c.number %> &mdash; <%= c.title %></option>
        <% }); %>
      </select>
      <label class="sr-only" for="fc-type">Filter by card type</label>
      <select id="fc-type">
        <option value="">All types</option>
        <option value="definition">Definition</option>
        <option value="fact">Fact</option>
        <option value="who">Who / person</option>
        <option value="date">Date</option>
        <option value="term">Term</option>
        <option value="why">Why explanation</option>
      </select>
    </div>

    <p class="ex-hint">Tap a card to flip it.</p>
    <div class="fc-grid" id="fc-grid" aria-live="polite"></div>
  </div>
</div>
<script>window.EXTRAS = { slug: "<%= book.slug %>" };</script>