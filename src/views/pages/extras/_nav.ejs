<nav class="ex-nav" aria-label="Study tools">
  <a class="ex-nav-back" href="/read/<%= book.slug %>/1">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    <span>Read the book</span>
  </a>
  <div class="chip-scroll ex-nav-scroll">
    <%
      // `tools` and `page` arrive as route locals. Included templates run in
      // their own scope, so they must never be reached for through a `var`
      // declared by the including template.
      var list = (typeof tools !== 'undefined' && tools) ? tools : [];
      var active = (typeof page !== 'undefined' && page) ? page : '';
    %>
    <% list.forEach(function (t) { %>
      <a class="chip chip-filter <%= active === t.slug ? 'is-active' : '' %>"
         href="/book/<%= book.slug %>/<%= t.slug %>"
         <%= active === t.slug ? 'aria-current="page"' : '' %>><%= t.label %></a>
    <% }); %>
  </div>
</nav>