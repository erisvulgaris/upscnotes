<div class="page">
  <%- include('_nav') %>
  <div class="container ex-pad">
    <div class="section-head">
      <p class="overline">Geography</p>
      <h1 class="page-title">Maps</h1>
      <p class="section-sub" id="map-count" role="status" aria-live="polite">Loading maps&hellip;</p>
    </div>

    <div class="ex-filters">
      <label class="sr-only" for="map-ch">Filter by chapter</label>
      <select id="map-ch">
        <option value="">All chapters</option>
        <% chapters.forEach(function (c) { %>
          <option value="<%= c.number %>">Ch <%= c.number %> &mdash; <%= c.title %></option>
        <% }); %>
      </select>
    </div>

    <p class="ex-hint">Tap a map to zoom.</p>
    <div class="map-grid" id="map-grid" aria-live="polite"></div>
  </div>
</div>

<div class="ex-lb" id="ex-lb" role="dialog" aria-modal="true" aria-label="Map" hidden>
  <button class="ex-lb-close" id="ex-lb-close" type="button" aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="20" height="20" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>
  <figure>
    <img id="ex-lb-img" alt="">
    <figcaption id="ex-lb-cap"></figcaption>
  </figure>
</div>

<script>window.EXTRAS = { slug: "<%= book.slug %>" };</script>