<div class="page">
  <%- include('_nav') %>
  <div class="container ex-pad">
    <div class="section-head">
      <p class="overline">Chronology</p>
      <h1 class="page-title">Timeline</h1>
      <p class="section-sub" id="tl-count" role="status" aria-live="polite">Loading events&hellip;</p>
    </div>

    <div class="chip-scroll" id="tl-eras" hidden></div>

    <div class="ex-filters">
      <label class="sr-only" for="tl-q">Search the timeline</label>
      <input type="search" id="tl-q" placeholder="Search events, people, places&hellip;" autocomplete="off">
    </div>

    <ol class="tl-list" id="tl-list" data-landmarks="<%= landmarksJson %>" aria-live="polite"></ol>
  </div>
</div>
<script>window.EXTRAS = { slug: "<%= book.slug %>" };</script>