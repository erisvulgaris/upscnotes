<div class="page">
  <%- include('_nav') %>
  <div class="container ex-pad">
    <div class="section-head">
      <p class="overline">Find it fast</p>
      <h1 class="page-title">Search this book</h1>
      <p class="section-sub" id="s-count" role="status" aria-live="polite">Type to search every section.</p>
    </div>

    <div class="ex-filters">
      <label class="sr-only" for="s-q">Search this book</label>
      <input type="search" id="s-q" placeholder="Search this book&hellip;" autocomplete="off" enterkeyhint="search"
             value="<%= q %>">
    </div>

    <div id="s-results" class="s-results" aria-live="polite"></div>
  </div>
</div>
<script>window.EXTRAS = { slug: "<%= book.slug %>" };</script>