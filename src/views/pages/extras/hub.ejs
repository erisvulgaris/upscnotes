<div class="page">
  <%- include('_nav') %>

  <div class="container ex-pad">
    <div class="section-head">
      <p class="overline">Study tools</p>
      <h1 class="page-title"><%= book.title %></h1>
      <p class="section-sub">
        Everything built alongside this title. Each tool links straight back to the chapter
        or section it came from.
      </p>
    </div>

    <div class="ex-grid">
      <% tools.forEach(function (t) { %>
        <a class="ex-card" href="/book/<%= book.slug %>/<%= t.slug %>">
          <span class="ex-card-ico" aria-hidden="true"><%- t.icon %></span>
          <h3><%= t.label %></h3>
          <p class="muted"><%= t.count %> <%= t.unit %></p>
        </a>
      <% }); %>
    </div>

    <div class="ex-foot">
      <div class="row" style="justify-content:space-between;">
        <div>
          <p class="overline">The book itself</p>
          <p class="small muted"><%= chapterCount %> chapters · read aloud or read silently</p>
        </div>
        <a class="btn btn-primary" href="/read/<%= book.slug %>/1">Start reading</a>
      </div>
    </div>
  </div>
</div>