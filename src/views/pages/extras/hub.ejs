<div class="page">
  <%- include('_nav', { book, page: 'hub' }) %>
  <div class="container ex-pad">
    <div class="section-head ex-head">
      <h1><%= book.title %> — Study tools</h1>
      <p class="muted">Practice questions, flashcards, timeline, maps, mains bank, glossary and full-text search. Each tool links straight back to the chapter section it came from.</p>
    </div>

    <div class="ex-grid">
      <a class="ex-card" href="/book/<%= book.slug %>/quiz">
        <span class="ex-card-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
        </span>
        <h3>Question bank</h3>
        <p class="muted">PYQs and practice — objective <em>and</em> mains.</p>
        <span class="ex-card-n"><%= meta.counts.questions %> questions</span>
      </a>
      <a class="ex-card" href="/book/<%= book.slug %>/flashcards">
        <span class="ex-card-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M12 4v16"/><path d="M2 12h20"/></svg>
        </span>
        <h3>Flashcards</h3>
        <p class="muted">Flip cards to drill the key definitions and facts.</p>
        <span class="ex-card-n"><%= meta.counts.flashcards %> cards</span>
      </a>
      <a class="ex-card" href="/book/<%= book.slug %>/timeline">
        <span class="ex-card-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
        <h3>Timeline</h3>
        <p class="muted">Every dated event in the book, in order.</p>
        <span class="ex-card-n"><%= meta.counts.timeline %> events</span>
      </a>
      <a class="ex-card" href="/book/<%= book.slug %>/maps">
        <span class="ex-card-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
        </span>
        <h3>Maps</h3>
        <p class="muted">Interactive map cards with places and PYQ links.</p>
        <span class="ex-card-n"><%= meta.counts.maps %> maps</span>
      </a>
      <a class="ex-card" href="/book/<%= book.slug %>/mains">
        <span class="ex-card-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </span>
        <h3>Mains bank</h3>
        <p class="muted">Past-year mains prompts with structure guidance.</p>
        <span class="ex-card-n"><%= meta.counts.mains %> questions</span>
      </a>
      <a class="ex-card" href="/book/<%= book.slug %>/glossary">
        <span class="ex-card-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </span>
        <h3>Glossary</h3>
        <p class="muted">Every key term in the book with its chapter.</p>
        <span class="ex-card-n"><%= meta.counts.glossary %> terms</span>
      </a>
      <a class="ex-card ex-card-full" href="/book/<%= book.slug %>/search">
        <span class="ex-card-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
        <h3>Search the book</h3>
        <p class="muted">Full-text search across all <%= book.title %> sections.</p>
        <span class="ex-card-n"><%= meta.counts.sections %> sections indexed</span>
      </a>
    </div>
  </div>
</div>
