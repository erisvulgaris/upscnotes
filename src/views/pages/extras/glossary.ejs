<div class="page">
  <%- include('_nav') %>
  <div class="container ex-pad">
    <div class="section-head">
      <p class="overline">Reference</p>
      <h1 class="page-title">Glossary</h1>
      <p class="section-sub" id="gl-count" role="status" aria-live="polite">Loading terms&hellip;</p>
    </div>

    <div class="ex-filters">
      <label class="sr-only" for="gl-search">Search terms</label>
      <input type="search" id="gl-search" placeholder="Search terms&hellip;" autocomplete="off">
      <label class="sr-only" for="gl-ch">Filter by chapter</label>
      <select id="gl-ch">
        <option value="">All chapters</option>
        <% chapters.forEach(function (c) { %>
          <option value="<%= c.number %>">Ch <%= c.number %> &mdash; <%= c.title %></option>
        <% }); %>
      </select>
    </div>

    <ul class="gl-list" id="gl-list" data-chapters="<%= chaptersJson %>" aria-live="polite"></ul>
  </div>
</div>
<script>window.EXTRAS = { slug: "<%= book.slug %>" };</script>