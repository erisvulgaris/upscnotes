<%# Book card. Expects: b (book row), subject (display string), href (optional)

     The generated cover art carries the genre and the title, so repeating
     either underneath is duplication. Real cover images are decorative and
     put the title in the meta block instead. Author, subject and chapter
     count are shown either way, because the cover never carries them. %>
<a class="book-card" href="<%= typeof href !== 'undefined' && href ? href : '/read/' + b.slug + '/1' %>"
   data-search="<%= (b.title + ' ' + (b.author || '') + ' ' + (subject || '')).toLowerCase().replace(/[<>&"]/g, '') %>">
  <span class="book-cover" <% if (b.color) { %>style="--cover:<%= b.color %>"<% } %>>
    <% if (b.cover) { %>
      <img loading="lazy" decoding="async" src="/content/<%= b.slug %>/cover.<%= b.cover.split('.').pop() %>" alt="">
    <% } else { %>
      <span class="cover-art">
        <span class="cover-genre"><%= b.category === 'ncert' ? 'NCERT' : 'UPSC' %></span>
        <span class="cover-title"><%= b.title %></span>
      </span>
    <% } %>
  </span>
  <span class="book-meta">
    <span class="overline"><%= subject || 'General' %></span>
    <% if (b.cover) { %><h3><%= b.title %></h3><% } %>
    <p class="muted"><%= b.author %></p>
    <span class="meta-row">
      <span class="chip"><%= b.chapter_count %> chapter<%= b.chapter_count === 1 ? '' : 's' %></span>
    </span>
  </span>
</a>