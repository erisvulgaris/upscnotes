<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · UPSCbooks</title>
  <meta name="description" content="UPSCbooks - One Library for your Entire Civil Services Journey. NCERT to UPSC, chapter-wise.">
  <meta name="csrf" content="<%= csrf %>">
  <meta property="og:title" content="<%= title %> · UPSCbooks">
  <meta property="og:description" content="One Library for your Entire Civil Services Journey">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://upscnotes.shop<%= path %>">
  <meta property="og:image" content="https://upscnotes.shop/og-default.png">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%236D28D9'/%3E%3Cstop offset='1' stop-color='%23F59E0B'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect x='4' y='4' width='56' height='56' rx='14' fill='url(%23g)'/%3E%3Ctext x='32' y='45' font-family='Inter,sans-serif' font-size='28' font-weight='700' fill='white' text-anchor='middle'%3EU%3C/text%3E%3C/svg%3E">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/app.css">
  <% if (typeof exCss !== 'undefined' && exCss) { %><link rel="stylesheet" href="/css/extras.css"><% } %>
  <link rel="stylesheet" href="/css/reader.css">
  <script>
    (function () {
      try {
        var d = JSON.parse(localStorage.getItem('upscbooks-theme') || 'null');
        if (d === 'dark') document.documentElement.classList.add('dark');
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <header class="site-head">
    <div class="container head-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </span>
        <span class="brand-text"><span style="font-weight:800;">UPSC</span>books<br><span style="font-size:10px;letter-spacing:.08em;font-weight:600;opacity:.7;display:block;margin-top:1px;">Read · Learn · Crack</span></span>
      </a>
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="22" height="22"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <nav class="head-nav" id="head-nav" aria-label="Primary">
        <a href="/" class="<%= path === '/' ? 'on' : '' %>">Home</a>
        <a href="/#books">Library</a>
        <a href="/ncerts">NCERT</a>
        <a href="/ncerts">UPSC</a>
        <a href="/#features">Notes</a>
        <a href="#" class="has-dropdown">Students <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M6 9l6 6 6-6"/></svg></a>
        <div class="head-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input type="text" placeholder="Search books, topics..." aria-label="Search">
        </div>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">◐</button>
        <% if (user) { %>
          <a href="/dashboard">Library</a>
          <a class="btn btn-primary btn-sm" href="/logout">Sign out</a>
        <% } else { %>
          <a class="btn btn-primary btn-sm" href="/login">Login / Sign Up</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main>
    <%- body %>
  </main>

  <footer class="site-foot">
    <div class="container">
      <div class="foot-grid">
        <div class="foot-col foot-brand-col">
          <span class="foot-brand"><span class="brand-mark" style="width:32px;height:32px;font-size:14px;background:white;color:#6D28D9;"> <svg viewBox="0 0 24 24" fill="none" stroke="#6D28D9" stroke-width="2" width="18" height="18"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg> </span> <span><strong>UPSC</strong>books<br><span style="font-size:11px;opacity:.7;font-weight:400;">Read · Learn · Crack</span></span></span>
          <p style="margin:12px 0 0;font-size:13px;opacity:.8;line-height:1.5;">"Small steps. Big Success."</p>
        </div>
        <div class="foot-col">
          <h4>Quick Links</h4>
          <a href="/">Home</a>
          <a href="/#books">Library</a>
          <a href="/ncerts">NCERT</a>
          <a href="/#features">UPSC</a>
        </div>
        <div class="foot-col">
          <h4>Resources</h4>
          <a href="/#features">Notes</a>
          <a href="/">Students</a>
          <a href="mailto:support@upscbooks.shop">Contact</a>
        </div>
        <div class="foot-col">
          <h4>Follow Us</h4>
          <div style="display:flex;gap:8px;margin-top:4px;">
            <a href="#" style="width:32px;height:32px;border-radius:8px;background:#FF0000;display:grid;place-items:center;color:white;font-size:12px;">▶</a>
            <a href="#" style="width:32px;height:32px;border-radius:8px;background:#0088CC;display:grid;place-items:center;color:white;">✈</a>
            <a href="#" style="width:32px;height:32px;border-radius:8px;background:linear-gradient(45deg,#F58529,#DD2A7B);display:grid;place-items:center;color:white;">◎</a>
          </div>
        </div>
      </div>
      <div class="foot-bottom">
        <span>© 2026 UPSCbooks. All rights reserved. | Made with ♥ for Students</span>
        <a href="#" class="back-to-top" id="back-to-top" aria-label="Back to top">↑</a>
      </div>
    </div>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>
