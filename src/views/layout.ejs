<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> · UPSCbooks</title>
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' && metaDesc ? metaDesc : 'UPSCbooks is a single lifetime library for civil services aspirants — 40+ NCERT textbooks, standard UPSC books, chapter-wise reading, text-to-speech, question banks and flashcards.' %>">
  <meta name="csrf" content="<%= csrf %>">
  <meta name="theme-color" content="#1E2A52">

  <link rel="canonical" href="/<%= path === '/' ? '' : path %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="UPSCbooks">
  <meta property="og:title" content="<%= title %> · UPSCbooks">
  <meta property="og:description" content="<%= typeof metaDesc !== 'undefined' && metaDesc ? metaDesc : 'One library for your entire civil services journey.' %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %> · UPSCbooks">
  <meta name="twitter:description" content="<%= typeof metaDesc !== 'undefined' && metaDesc ? metaDesc : 'One library for your entire civil services journey.' %>">

  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/img/favicon.svg">
  <link rel="manifest" href="/manifest.webmanifest">

  <link rel="preload" href="/assets/fonts/Cambay-700-3.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/Cambay-400-0.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/app.css">
  <% if (typeof exCss !== 'undefined' && exCss) { %><link rel="stylesheet" href="/css/extras.css"><% } %>

  <script>
    /* Resolve the theme before first paint so there is no flash. */
    (function () {
      try {
        var saved = localStorage.getItem('upscbooks-theme');
        var theme = saved === 'dark' || saved === 'light'
          ? saved
          : (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>

  <header class="site-head">
    <div class="container head-inner">
      <a class="brand" href="/" aria-label="UPSCbooks — home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#FFFDF9" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </span>
        <span class="brand-text">
          <span class="brand-name">UPSCbooks</span>
          <span class="brand-tag">Read · Learn · Crack</span>
        </span>
      </a>

      <nav class="head-nav" aria-label="Primary">
        <a href="/" <%= path === '/' ? 'aria-current="page"' : '' %>>Home</a>
        <a href="/library" <%= path === '/library' ? 'aria-current="page"' : '' %>>All books</a>
        <a href="/ncerts" <%= path.startsWith('/ncerts') ? 'aria-current="page"' : '' %>>NCERT</a>
        <% if (typeof subjectsNav !== 'undefined' && subjectsNav && subjectsNav.length) { %>
          <div class="has-menu">
            <button class="nav-menu-btn" type="button" aria-expanded="false" aria-controls="subject-menu">
              Subjects
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="nav-menu" id="subject-menu" hidden>
              <ul>
                <% subjectsNav.forEach(function (s) { %>
                  <li>
                    <a href="/library#<%= s.anchor %>">
                      <span class="nav-menu-t"><%= s.subject %></span>
                      <span class="nav-menu-n"><%= s.count %></span>
                    </a>
                  </li>
                <% }); %>
              </ul>
              <a class="nav-menu-all" href="/library">Browse the whole library
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        <% } %>
        <% if (user) { %>
          <a href="/dashboard" <%= path === '/dashboard' ? 'aria-current="page"' : '' %>>My library</a>
          <% if (isAdmin) { %><a href="/admin" <%= path.startsWith('/admin') ? 'aria-current="page"' : '' %>>Admin</a><% } %>
        <% } %>
      </nav>

      <form class="head-search" action="/search" method="get" role="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <label class="sr-only" for="q">Search the library</label>
        <input type="search" id="q" name="q" placeholder="Search books, authors, subjects…"
               value="<%= path === '/search' ? (typeof q !== 'undefined' && q ? q : '') : '' %>" autocomplete="off">
      </form>

      <div class="head-actions">
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch to dark mode" title="Toggle theme">
          <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true" hidden><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <% if (user) { %>
          <a class="btn btn-primary btn-sm head-cta" href="/dashboard">My library</a>
        <% } else { %>
          <a class="btn btn-ghost btn-sm head-cta" href="/login">Sign in</a>
        <% } %>
        <button class="icon-btn mobile-menu-btn" id="mobile-menu-btn" type="button"
                aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="22" height="22" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile navigation drawer -->
  <div class="drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="drawer-backdrop" data-drawer-close></div>
    <div class="drawer-panel">
      <div class="drawer-head">
        <span class="brand">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#FFFDF9" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </span>
          <span class="brand-text"><span class="brand-name">UPSCbooks</span></span>
        </span>
        <button class="icon-btn" type="button" data-drawer-close aria-label="Close menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="20" height="20" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <form class="library-search" action="/search" method="get" role="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <label class="sr-only" for="dq">Search the library</label>
        <input type="search" id="dq" name="q" placeholder="Search the library…" autocomplete="off">
      </form>

      <nav class="drawer-nav" aria-label="Mobile">
        <span class="overline drawer-label">Browse</span>
        <a href="/" <%= path === '/' ? 'aria-current="page"' : '' %>>Home
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a>
        <a href="/ncerts" <%= path.startsWith('/ncerts') ? 'aria-current="page"' : '' %>>NCERT textbooks
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a>
        <a href="/library" <%= path === '/library' ? 'aria-current="page"' : '' %>>All books
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a>
        <% if (typeof subjectsNav !== 'undefined' && subjectsNav && subjectsNav.length) { %>
          <span class="drawer-label">Subjects</span>
          <div class="drawer-subjects">
            <% subjectsNav.forEach(function (s) { %>
              <a href="/library#<%= s.anchor %>"><%= s.subject %><span><%= s.count %></span></a>
            <% }); %>
          </div>
        <% } %>
        <% if (user) { %>
          <span class="overline drawer-label">Your account</span>
          <a href="/dashboard" <%= path === '/dashboard' ? 'aria-current="page"' : '' %>>My library
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a>
          <% if (isAdmin) { %>
            <a href="/admin" <%= path.startsWith('/admin') ? 'aria-current="page"' : '' %>>Admin
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a>
          <% } %>
          <div class="drawer-foot">
            <form method="post" action="/logout">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-ghost btn-block" type="submit">Sign out</button>
            </form>
          </div>
        <% } else { %>
          <div class="drawer-foot">
            <a class="btn btn-ghost btn-block" href="/login">Sign in</a>
            <a class="btn btn-primary btn-block" href="/signup">Create free account</a>
          </div>
        <% } %>
      </nav>

      <p class="tiny muted" style="padding: var(--sp-4) var(--sp-3) 0;">
        Need help? <a href="mailto:support@upscbooks.shop">support@upscbooks.shop</a>
      </p>
    </div>
  </div>

  <main id="main">
    <%- body %>
  </main>

  <footer class="site-foot">
    <div class="container">
      <div class="foot-grid">
        <div class="foot-col">
          <span class="foot-brand">
            <span class="brand-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="#FFFDF9" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </span>
            <span class="brand-text">
              <span class="brand-name">UPSCbooks</span>
              <span class="brand-tag">Read · Learn · Crack</span>
            </span>
          </span>
          <p class="foot-blurb">One lifetime library for the full civil services journey — NCERT through standard UPSC titles, chapter-wise, with reading and revision tools built in.</p>
          <div class="foot-social">
            <a href="mailto:support@upscbooks.shop" aria-label="Email support">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
            </a>
            <a href="/terms" aria-label="Terms of service">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8"/></svg>
            </a>
            <a href="/privacy" aria-label="Privacy policy">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </a>
          </div>
        </div>
        <div class="foot-col">
          <h4>Library</h4>
          <nav>
            <a href="/library">All books</a>
            <a href="/ncerts">NCERT textbooks</a>
            <a href="/library#textbooks">UPSC titles</a>
            <a href="/search">Search</a>
          </nav>
        </div>
        <div class="foot-col">
          <h4>Account</h4>
          <nav>
            <% if (user) { %>
              <a href="/dashboard">My library</a>
              <a href="/checkout">Lifetime access</a>
            <% } else { %>
              <a href="/login">Sign in</a>
              <a href="/signup">Create account</a>
              <a href="/checkout">Lifetime access</a>
            <% } %>
            <a href="mailto:support@upscbooks.shop">Support</a>
          </nav>
        </div>
        <div class="foot-col">
          <h4>Legal</h4>
          <nav>
            <a href="/terms">Terms of service</a>
            <a href="/privacy">Privacy policy</a>
            <a href="/refunds">Refund policy</a>
          </nav>
        </div>
      </div>
      <div class="foot-bottom">
        <span>&copy; <%= getYear() %> UPSCbooks. All rights reserved.</span>
        <a href="#main" class="back-to-top" id="back-to-top" aria-label="Back to top">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="m5 12 7-7 7 7M12 19V5"/></svg>
        </a>
      </div>
    </div>
  </footer>

  <button class="back-to-top hide" id="to-top-fab" type="button" aria-label="Back to top" style="position:fixed;right:16px;bottom:16px;z-index:var(--z-dock);">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="m5 12 7-7 7 7M12 19V5"/></svg>
  </button>

  <script src="/js/app.js" defer></script>
  <% if (typeof exJs !== 'undefined' && exJs) { %><script src="/js/extras.js" defer></script><% } %>
</body>
</html>